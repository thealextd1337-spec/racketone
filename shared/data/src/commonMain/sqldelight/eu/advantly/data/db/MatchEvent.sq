-- Event-Log aller Matches (append-only, 01 §5.1). Ordnung (lamport, device_id, id) wie 01 §3.2.
-- Die Spalte uploaded (Outbox) kommt mit dem Cloud-Sync in P2. Schema-Migrationen siehe 1.sqm.
CREATE TABLE match_event (
    id TEXT NOT NULL PRIMARY KEY,
    match_id TEXT NOT NULL,
    device_id TEXT NOT NULL,
    device_seq INTEGER NOT NULL,
    lamport INTEGER NOT NULL,
    wall_clock_ms INTEGER NOT NULL DEFAULT 0,
    parent_id TEXT,
    -- Payload-Typ (z. B. PointWon) für Abfragen ohne JSON-Parsing
    type TEXT NOT NULL DEFAULT '',
    payload TEXT NOT NULL,
    -- 1 = mindestens eine Gegenstelle hat das Event (Ack, Summary oder von dort empfangen); 0 = Ausgangs-Rückstand
    confirmed INTEGER NOT NULL DEFAULT 0,
    UNIQUE (match_id, device_id, device_seq)
);

-- Ausgangs-Rückstand über alle Matches (Sofort-Sync, Anzeige „N ausstehend“)
CREATE INDEX match_event_unconfirmed ON match_event (confirmed, match_id);

-- Deckt eventsForMatch inkl. Sortierung (lamport, device_id, id) ab – 01 §3.2.
-- Bereichsabfragen je Gerät (Anti-Entropie) nutzen den UNIQUE-Index (match_id, device_id, device_seq).
CREATE INDEX match_event_order ON match_event (match_id, lamport, device_id, id);

insert:
INSERT INTO match_event (id, match_id, device_id, device_seq, lamport, wall_clock_ms, parent_id, type, payload, confirmed)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

countById:
SELECT count(*) FROM match_event WHERE id = ?;

countBySequence:
SELECT count(*) FROM match_event WHERE match_id = ? AND device_id = ? AND device_seq = ?;

eventsForMatch:
SELECT id, match_id, device_id, device_seq, lamport, wall_clock_ms, parent_id, type, payload
FROM match_event
WHERE match_id = ?
ORDER BY lamport, device_id, id;

eventsInRange:
SELECT id, match_id, device_id, device_seq, lamport, wall_clock_ms, parent_id, type, payload
FROM match_event
WHERE match_id = ? AND device_id = ? AND device_seq BETWEEN ? AND ?
ORDER BY lamport, device_id, id;

sequencesForMatch:
SELECT device_id, device_seq FROM match_event WHERE match_id = ? ORDER BY device_id, device_seq;

maxLamport:
SELECT coalesce(max(lamport), 0) FROM match_event WHERE match_id = ?;

maxDeviceSeq:
SELECT coalesce(max(device_seq), 0) FROM match_event WHERE match_id = ? AND device_id = ?;

countForMatch:
SELECT count(*) FROM match_event WHERE match_id = ?;

markConfirmed:
UPDATE match_event SET confirmed = 1 WHERE match_id = ? AND device_id = ? AND device_seq = ?;

markConfirmedUpTo:
UPDATE match_event SET confirmed = 1 WHERE match_id = ? AND device_id = ? AND device_seq <= ? AND confirmed = 0;

unconfirmedCount:
SELECT count(*) FROM match_event WHERE confirmed = 0;

unconfirmedMatches:
SELECT DISTINCT match_id FROM match_event WHERE confirmed = 0 ORDER BY match_id;

unconfirmedForMatch:
SELECT id, match_id, device_id, device_seq, lamport, wall_clock_ms, parent_id, type, payload
FROM match_event
WHERE match_id = ? AND confirmed = 0
ORDER BY lamport, device_id, id;

deleteForMatch:
DELETE FROM match_event WHERE match_id = ?;

CREATE INDEX match_event_type ON match_event (type, match_id);

identityEvents:
SELECT id, match_id, device_id, device_seq, lamport, wall_clock_ms, parent_id, type, payload
FROM match_event WHERE match_id = ? AND type IN ('MatchCreated', 'PlayerAssigned')
ORDER BY lamport, device_id, id;

assignmentMatches:
SELECT DISTINCT match_id FROM match_event WHERE type = 'PlayerAssigned';

assignmentMatchesForSlot:
SELECT DISTINCT match_id FROM match_event WHERE type = 'PlayerAssigned' AND instr(payload, :slot) > 0;
