-- P2-B1: bestehende Events bleiben unverändert und sind zunächst für Cloud-Upload ausstehend.
ALTER TABLE match_event ADD COLUMN cloud_state INTEGER NOT NULL DEFAULT 0;
ALTER TABLE match_event ADD COLUMN cloud_rejection TEXT;
CREATE INDEX match_event_cloud_pending ON match_event (cloud_state, match_id, lamport, device_id, id);

CREATE TABLE cloud_cursor (
    profile_id TEXT NOT NULL,
    stream TEXT NOT NULL,
    value INTEGER NOT NULL CHECK (value >= 0),
    PRIMARY KEY (profile_id, stream)
);
