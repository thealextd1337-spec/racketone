<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- B4: Netzbedingung geplanter Abgleiche (ab Android 14 Pflicht) und Netz-Auslöser im Vordergrund -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- B4: geplante Abgleiche überstehen einen Neustart (JobInfo.setPersisted) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".AdvantlyPhoneApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <!-- Edge-to-Edge: Fenster nie für die Tastatur verschieben (sonst rutscht der Inhalt unter die Statusleiste);
             Compose weicht über WindowInsets.safeDrawing (inkl. ime) aus. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name=".auth.AccountExportProvider"
            android:authorities="${applicationId}.account.exports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/account_export_paths" />
        </provider>

        <!-- S1: Ergebniskarte als Bild teilen (nur cacheDir/match-images) -->
        <provider
            android:name=".MatchImageProvider"
            android:authorities="${applicationId}.match.images"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/match_image_paths" />
        </provider>

        <!-- B4: geplante Abgleiche (Matchende, Backoff, Fortsetzung, periodisch) -->
        <service
            android:name=".sync.PhoneSyncJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- W1-I: Uhr-Events auch ohne laufende Activity empfangen (Wear Data Layer, Pfade aus device-link) -->
        <service
            android:name=".sync.PhoneSyncListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/advantly/link"
                    android:scheme="wear" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:path="/advantly/telemetry/live"
                    android:scheme="wear" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:host="*"
                    android:pathPrefix="/advantly/link/q"
                    android:scheme="wear" />
            </intent-filter>
        </service>
    </application>

</manifest>
